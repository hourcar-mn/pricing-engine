# R2 credentials, used by r2_sync.py.
#
# The deployed container gets these from Worker secrets (see README). Locally
# you only need them to run `python r2_sync.py push`; leave them blank and the
# dashboard reads data/ straight off disk, exactly as it always has.
#
# Create the token at: Cloudflare dashboard > R2 > Manage API tokens,
# with Object Read & Write on the pricing-engine bucket.
R2_ENDPOINT=
R2_BUCKET=pricing-engine
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
