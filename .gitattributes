# normalize line endings in the repo, keep native ones in the working tree.
# Without this, whether a file lands in a commit as LF or CRLF depends on each
# contributor's core.autocrlf -- DataPrep/CleanTrips.py was already committed
# as CRLF while everything beside it was LF.
* text=auto

# read by Docker when it builds the container image, so LF regardless of who
# checked it out
Dockerfile text eol=lf
*.sh text eol=lf

# generated by npm, not written by hand: collapsed in GitHub diffs and skipped
# by git's own. Still committed -- it's what pins wrangler and the 40 packages
# under it, so a deploy months from now builds the same Worker.
package-lock.json linguist-generated=true -diff

# gitignored today, but the rule stays so a stray `add -f` of a 258MB data file
# can't make every future diff useless
*.csv -diff
